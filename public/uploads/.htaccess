# En esta carpeta solo se sirven imágenes y documentos: nunca se ejecuta código.
php_flag engine off
Options -ExecCGI -Indexes
AddType text/plain .php .php3 .php4 .php5 .php7 .php8 .phtml .pl .py .cgi .sh .html .htm

<FilesMatch "\.(php|php3|php4|php5|php7|php8|phtml|pl|py|cgi|sh|htaccess)$">
    Require all denied
</FilesMatch>
